{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "This graph shows movement of the FDI net inflows, personal remittances and IMF credit over the years and compares these to movement in the foreign reserves. ",
    "title": {
      "text": "Change in selected variables affecting forex reserves over the years (1975-2023)",
      "subtitle": [
        " (Current USD)",
        "Source: World Bank"
      ],
      "subtitleFontStyle": "italic",
      "subtitleFontSize": 10,
      "anchor": "start",
      "color": "darkblue"
    },
    "data": {
      "url": "https://raw.githubusercontent.com/MMakina/MMakina.github.io/refs/heads/main/reshapedWB_data.csv"
    },
    "height": 400,
    "width": 600,
    "mark": {"type": "bar"},
    "transform": [
      {
        "filter": "datum.Year == year"
      },
      {
        "filter": {
          "field": "variable",
          "oneOf": [
            "FDI net inflows",
            "Personal remittances",
            "IMF Credit",
            "Foreign Reserves"
          ]
        }
      }
    ],
    "params": [
      {
        "name": "year",
        "value": 2023,
        "bind": {
          "input": "range",
          "min": 1975,
          "max": 2023,
          "step": 1,
          "name": "Select the year:"
        }
      }
    ],
    "encoding": {
      "y": {
        "field": "value",
        "type": "quantitative",
        "title": "",
        "axis": {"grid": false}
      },
      "x": {
        "field": "variable",
        "type": "nominal",
        "title": "",
        "axis": {"grid": false},
        "sort": ["FDI net inflows", "Personal remittances", "IMF Credit", "Foreign Reserves"]
      },
      "color": {
        "field": "variable",
        "scale": {"scheme": "yellowgreenblue"},
        "title": "Variable"
      },
      "tooltip": [
        {"field": "variable", "title": "Variable"},
        {"field": "value", "title": "Value"},
        {"field": "Year", "title": "Year"}
      ]
    }
  }
  